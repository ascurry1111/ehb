<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#101010"
    android:padding="16dp">

    <!-- Deliberately small and out of the way — battery is background info, not a focus. -->
    <TextView
        android:id="@+id/tvBattery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="—"
        android:textColor="#8BC34A"
        android:textSize="11sp"
        android:alpha="0.7" />

    <!-- Pitch is a set-once-per-demo control, not something touched mid-ring, so it
         gets its own small row rather than living in the hero block below.
         +/- nudge a half step instantly (no re-synthesis, see RingPlayer.nudgeSemitone);
         the Spinner is for jumping straight to a distant pitch. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pitch"
            android:textColor="#888888"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnPitchDown"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:text="-"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:background="#2A2A2A" />

        <Spinner
            android:id="@+id/spinnerPitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:minWidth="96dp"
            android:popupBackground="#1B1B1B" />

        <Button
            android:id="@+id/btnPitchUp"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:background="#2A2A2A" />

    </LinearLayout>

    <!-- Instrument voice — procedural synth presets, see Instrument.kt. Occasional/
         demo-purpose choice, so it's fine that this takes the slower re-synthesis
         path (no fast nudge equivalent for this one, unlike pitch). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sound"
            android:textColor="#888888"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spinnerInstrument"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:minWidth="140dp"
            android:popupBackground="#1B1B1B" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Starting..."
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <TextView
            android:id="@+id/tvRingCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FFD54F"
            android:textSize="80sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRingLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="rings"
            android:textColor="#AAAAAA"
            android:textSize="18sp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/tvLastPeak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Last peak: —"
            android:textColor="#CCCCCC"
            android:textSize="16sp" />

        <!-- Tap to toggle the ring→phone / phone→sound breakdown — deliberately no
             visible button chrome for this, per the "unobtrusive" ask. -->
        <TextView
            android:id="@+id/tvLatency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Latency: —"
            android:textColor="#4FC3F7"
            android:textSize="16sp"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

        <!-- Manual damp: stops the currently sounding tone, same as the bell's
             damp gesture. Unlike the latency toggle above, this is meant to be
             obvious and easy to hit mid-demo. -->
        <Button
            android:id="@+id/btnDamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="32dp"
            android:text="Damp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#37474F" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="RING LOG"
            android:textColor="#777777"
            android:textSize="12sp"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/tvClearLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clear"
            android:textColor="#4FC3F7"
            android:textSize="13sp"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

    </LinearLayout>

    <ListView
        android:id="@+id/lvRingLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#222222"
        android:dividerHeight="1dp"
        android:scrollbars="vertical" />

</LinearLayout>

<!-- Shown while RingPlayer is re-synthesizing an instrument change. clickable+focusable
     with no listener is the standard trick to make an overlay swallow touches to
     everything behind it, so the pitch/instrument controls can't be poked again mid-change
     and start a second overlapping request. See RingPlayer.setOnBusyChangedListener. -->
<LinearLayout
    android:id="@+id/busyOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#DD000000"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvBusyMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Changing instrument…"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

</LinearLayout>

</FrameLayout>
