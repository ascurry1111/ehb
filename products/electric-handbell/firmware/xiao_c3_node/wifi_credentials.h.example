/*
  Copy this file to "wifi_credentials.h" (same folder) and fill in your real
  network details. wifi_credentials.h is gitignored on purpose -- it holds a
  real WiFi password and should never be committed. This .example file is
  the only one tracked in git.
*/
#pragma once

#define WIFI_SSID     "your-network-name"
#define WIFI_PASSWORD "your-network-password"

// Optional: only someone who knows this can push OTA firmware to the board.
// Leave as "" for no password -- fine for a private home network demo, but
// set one if the network isn't trusted.
#define OTA_PASSWORD  ""
